# Copia este archivo como .env y ajusta los valores

# Puerto en el que corre el servidor (por defecto: 3000)
PORT=3000

# Clave secreta para las sesiones — CÁMBIALA por una cadena aleatoria larga
SESSION_SECRET=cambia-esto-por-una-clave-segura-aleatoria

# Bloqueo por intentos fallidos (lockout)
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=5

# En producción (Render): NODE_ENV=production
# NODE_ENV=production
